# =============================================================
# TEXTUS — TITKOK (sablon)
# =============================================================
#
# 1) Másold ezt a fájlt `secrets.toml` néven ugyanebbe a mappába.
# 2) Cseréld ki az alábbi értékeket.
# 3) A `secrets.toml` SOHA nem kerül GitHubra (`.gitignore` blokkolja).
#
# Hostinghoz (Streamlit Cloud) a kulcsokat a platform „Secrets"
# felületén add meg — ne ezt a fájlt töltsd fel.
#
# =============================================================
# OAuth / publikus URL (KRITIKUS ÉLESEN)
# =============================================================
#
# A Google-bejelentkezés a Streamlit natív `st.login()` + Google OIDC
# útvonalán megy (NEM a Supabase Auth callbackjén).
#
# Streamlit Cloud Secrets — kötelező éles értékek:
#
#   TEXTUS_PUBLIC_URL = "https://emmaus.streamlit.app"
#
#   [auth]
#   redirect_uri = "https://emmaus.streamlit.app/oauth2callback"
#   cookie_secret = "hosszu-veletlen-titok"
#   client_id = "....apps.googleusercontent.com"
#   client_secret = "...."
#   server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# Alias (opcionális, visszafelé kompatibilis): APP_PUBLIC_URL
#
# Lokális fejlesztéshez:
#   TEXTUS_PUBLIC_URL = "http://localhost:8501"
#   redirect_uri      = "http://localhost:8501/oauth2callback"
#
# ÉLESEN TILOS: redirect_uri = "http://localhost:8501/oauth2callback"
# (különben a Cloud belépés a fejlesztői gépre próbál visszatérni).
#
# Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs:
#   - http://localhost:8501/oauth2callback
#   - https://emmaus.streamlit.app/oauth2callback
# (Mindkettő a Streamlit app oauth2callback pathja — NEM a Supabase
#  https://….supabase.co/auth/v1/callback, mert a login nem Supabase Auth.
#  Ha máshol még használsz Supabase Auth-ot, tartsd meg a Supabase
#  /auth/v1/callback URI-t is a Google kliensben.)
#
# Supabase Dashboard (projekt tárolás; Site URL a konzisztencia miatt):
#   Site URL:      https://emmaus.streamlit.app
#   Redirect URLs: https://emmaus.streamlit.app/**
#                  http://localhost:8501/**
#
# =============================================================

GEMINI_API_KEY = "ide_jon_a_sajat_kulcsod"

# Éles Cloudon ezt a publikus HTTPS címet add meg:
# TEXTUS_PUBLIC_URL = "https://emmaus.streamlit.app"
# Lokálisan:
# TEXTUS_PUBLIC_URL = "http://localhost:8501"
# Alias (opcionális): APP_PUBLIC_URL = "https://emmaus.streamlit.app"

# Google Analytics 4 (opcionális — alapértelmezés: G-WD39Q5K1MM)
# TEXTUS_GA_MEASUREMENT_ID = "G-WD39Q5K1MM"

# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"   # csak lokál
# # redirect_uri = "https://emmaus.streamlit.app/oauth2callback"  # éles
# cookie_secret = "...."
# client_id = "...."
# client_secret = "...."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# [supabase]
# url = "https://YOUR_PROJECT.supabase.co"
# key = "YOUR_SERVICE_OR_ANON_KEY"

# --- Visszajelzés űrlap (opcionális) ---
# FEEDBACK_TO_EMAIL = "masik@email.hu"
