#
# 1) Másold ezt a fájlt `secrets.toml` néven ugyanebbe a mappába.
# 2) Cseréld ki az alábbi értéket a saját Gemini API kulcsodra.
# 3) A `secrets.toml` SOHA nem kerül GitHubra (`.gitignore` blokkolja).
#
# Hostinghoz (Streamlit Cloud / Hugging Face / Render) a kulcsot
# a platform „Secrets" felületén kell megadni — nem ezt a fájlt
# tölteni fel.

GEMINI_API_KEY = "ide_jon_a_sajat_kulcsod"

