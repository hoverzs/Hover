# Példa környezeti változók (az alkalmazás jelenlegi verziója az API kulcsot
# a Streamlit oldalsáv „Beállítások” fülén kéri be; ez a fájl csak jövőbeli
# bővítésekhez maradhat itt.)
#
# GEMINI_API_KEY=ide_a_kulcs
#
# Későbbi fejlesztés (MOST NINCS IMPLEMENTÁLVA): közös alkalmazáskulcs
# napi / vendég kvótája. A jelenlegi védelem: session cooldown + prompt
# untrusted keret + workspace sanitize.
# GUEST_DAILY_AI_LIMIT=
# AUTH_DAILY_AI_LIMIT=
# EXPENSIVE_ACTION_DAILY_LIMIT=
#
# Bemeneti hosszhatárok (opcionális felülírás):
# TEXTUS_LIMIT_USER_NOTE=4000
# TEXTUS_LIMIT_BIBLE_PASSAGE=12000
# TEXTUS_LIMIT_CHAT_MESSAGE=4000
