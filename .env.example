# =============================================================
# TEXTUS — környezeti változók (példa)
# =============================================================
#
# 1) Másold:  copy .env.example .env
# 2) Töltsd ki a valódi értékeket a .env-ben.
# 3) A `.env` a .gitignore miatt NEM kerül GitHubra.
#
# Megjegyzés: Streamlit Cloudon a titkokat a platform
# „Secrets” felületén add meg (lásd .streamlit/secrets.toml.example).
# Lokálisan használhatsz `.env`-et (ha a shell/IDE betölti) VAGY
# `.streamlit/secrets.toml`-t — az app mindkettőt olvassa.
#
# =============================================================

# Google Gemini API kulcs (kötelező AI funkciókhoz)
GEMINI_API_KEY=

# Szentiras.eu REST API (RÚF 2014 automatikus betöltés)
SZENTIRAS_EU_API_KEY=

# Publikus app URL (OAuth redirecthez; élesen HTTPS)
# TEXTUS_PUBLIC_URL=http://localhost:8501
# TEXTUS_PUBLIC_URL=https://emmaus.streamlit.app

# Google Analytics 4 (opcionális)
# TEXTUS_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcionális AI kvóták / bemeneti limitek
# GUEST_DAILY_AI_LIMIT=
# AUTH_DAILY_AI_LIMIT=
# EXPENSIVE_ACTION_DAILY_LIMIT=
# TEXTUS_LIMIT_USER_NOTE=4000
# TEXTUS_LIMIT_BIBLE_PASSAGE=12000
# TEXTUS_LIMIT_CHAT_MESSAGE=4000

# Google OAuth / Supabase: ezeket inkább .streamlit/secrets.toml-ban
# tartsd ([auth], [supabase] szekciók) — lásd secrets.toml.example.
